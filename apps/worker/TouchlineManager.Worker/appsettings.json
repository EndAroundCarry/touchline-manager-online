{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Worker": {
    "PollIntervalSeconds": 5,
    "MaxConcurrentJobs": 4,
    "LeaseSeconds": 120,
    "MaxIdlePollIntervalSeconds": 30
  },
  "Training": {
    "EnableDailyProgression": false,
    "CheckIntervalSeconds": 300
  },
  "Matchday": {
    "EnableMatchdayWorker": true,
    "CheckIntervalSeconds": 300,
    "MaterializeHorizonDays": 21
  },
  "AiClubs": {
    "EnableEvaluation": true,
    "CheckIntervalSeconds": 300
  },
  "Auctions": {
    "EnableAuctions": true,
    "CheckIntervalSeconds": 600
  },
  "AiMarket": {
    "EnableEvaluation": true,
    "CheckIntervalSeconds": 300
  },
  "Provisioning": {
    "EnableProvisioning": true,
    "CheckIntervalSeconds": 60
  },
  "Inactivity": {
    "EnableEvaluation": true,
    "CheckIntervalSeconds": 300
  },
  "Reminders": {
    "EnableReminders": true,
    "CheckIntervalSeconds": 300
  },
  "Outbox": {
    "EnableDispatch": true,
    "CheckIntervalSeconds": 60,
    "BatchSize": 50
  }
}
