<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TouchlineManager.Application\TouchlineManager.Application.csproj" />
    <ProjectReference Include="..\..\..\src\TouchlineManager.Infrastructure\TouchlineManager.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\TouchlineManager.Contracts\TouchlineManager.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
