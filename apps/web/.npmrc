# The web build needs its devDependencies: the Angular CLI, the compiler, TypeScript, Tailwind and
# Vitest all live there. Declaring `include=dev` here means a shell that exports NODE_ENV=production
# cannot silently produce an install that cannot build. An explicit `--omit=dev` on the command line
# still wins where a lean install is genuinely wanted.
include=dev

# Keep installs reproducible and the log readable.
audit=false
fund=false
save-exact=false
