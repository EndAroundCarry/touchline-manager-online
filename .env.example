# Copy to .env and fill in. Never commit .env.
# Consumed by infra/compose.yaml for local development.

# --- PostgreSQL ---
# 55432 by default: 5432 is frequently already in use on a developer machine, and a second listener
# on the same host port makes connections land unpredictably.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=touchline
POSTGRES_USER=touchline_app
POSTGRES_PASSWORD=local_dev_password_change_me

# Migration role, used only by the controlled pre-deploy migration job (ADR-0008).
# Local Compose uses a single role; the separation is implemented in Stage 14.
POSTGRES_MIGRATION_USER=touchline_migrator
POSTGRES_MIGRATION_PASSWORD=local_dev_migration_password_change_me

# Runtime connection string. Keep the password out of source control.
ConnectionStrings__Database=Host=localhost;Port=55432;Database=touchline;Username=touchline_app;Password=local_dev_password_change_me

# --- Mail catcher (local only; production uses Postmark per ADR-0008) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@touchline.local
Mailpit__WebPort=8025

# The API reads these; they are not consumed by docker compose.
Email__Host=localhost
Email__Port=1025
Email__FromAddress=no-reply@touchline.local

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__AllowedOrigins__0=http://localhost:4200

# --- Auth (ADR-0002) ---
# Access-token signing key: 32+ bytes. Development has a committed dev-only value in
# appsettings.Development.json; every other environment must supply its own via secret storage.
# Generate one with: openssl rand -base64 48
Auth__SigningKey=
# Where verification and reset links point. Must be the web client's public URL.
Auth__ClientBaseUrl=http://localhost:4200

# --- Worker ---
Worker__PollIntervalSeconds=5
Worker__MaxConcurrentJobs=4

# --- Telemetry (optional locally) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=touchline-api

# --- World ---
# The world's shape: read by the seeder (`npm run seed`) and by the onboarding endpoints. The
# generation seed is what makes a pyramid reproducible (FIC-7, PYR-14); the first-season date is
# rounded forward to the next legal matchday, so any date will do (CAL-2, CAL-5).
World__Name=Touchline Manager World
World__GenerationSeed=touchline-world-1
World__FirstSeasonStartDate=2026-10-06
# How long a client should wait before re-asking whether a full country's next tier is ready (PYR-10).
World__ProvisioningPollSeconds=30

# --- Match-engine world secret (Stage 5) ---
# 32+ random bytes, base64. Used to derive match seeds (ADR-0004). Rotate per environment. This is a
# secret and has nothing to do with the seeding settings above; it just lives in the same section.
World__SeedSecret=
