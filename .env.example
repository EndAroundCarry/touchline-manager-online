# Local development environment template.
# Copy to .env and adjust. NEVER commit real secrets (plan §12.2).

# --- Postgres (infra/compose.yaml) ---
POSTGRES_DB=footballmanager
POSTGRES_USER=footballmanager
POSTGRES_PASSWORD=localdev-only-change-me
POSTGRES_PORT=55432

# --- Apps ---
ASPNETCORE_ENVIRONMENT=Development
API_URL=http://localhost:5080
WORKER_HEALTH_URL=http://localhost:5081
WEB_URL=http://localhost:4200
API_PORT=5080
WORKER_PORT=5081
WEB_PORT=4200

# --- Data protection / secrets (local only) ---
# Used to derive match seed HMACs. Rotating it invalidates unrevealed seeds.
WORLD_SECRET=localdev-world-secret-not-for-production

# --- Email (Mailpit catcher) ---
MAIL_HOST=localhost
MAIL_PORT=1025
